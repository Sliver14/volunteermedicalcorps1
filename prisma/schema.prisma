// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  profile       Profile?
}

model Profile {
  id        String  @id @default(cuid())
  bio       String?
  avatar    String?
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id])
}

enum Role {
  USER
  ADMIN
  VOLUNTEER
}

model HeroSlide {
  id          String   @id @default(cuid())
  title       String
  subTitle    String?
  description String?
  image       String
  link        String?
  btnText     String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model DailyConfession {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  title     String
  text      String
  audioUrl  String?
  link      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MarqueeItem {
  id        String   @id @default(cuid())
  content   String
  link      String?
  color     String?  @default("red")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Campaign {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  image       String
  region      String?
  country     String?
  category    String   // e.g., "Good Deeds Campaigns", "Medical Projects", etc.
  date        DateTime?
  isActive    Boolean  @default(true)
  ctaType     String?  @default("DONATE") // DONATE, REGISTER, LINK, etc.
  ctaText     String?  @default("Give Now")
  ctaLink     String?
  target      Float?   @default(0)
  raised      Float?   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model News {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  image       String?
  category    String?
  author      String?
  date        DateTime @default(now())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Blog {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  image       String?
  category    String?
  author      String?
  date        DateTime @default(now())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  image       String?
  location    String?
  date        DateTime
  isLive      Boolean  @default(false)
  streamUrl   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Gallery {
  id          String   @id @default(cuid())
  title       String?
  imageUrl    String
  category    String?  // e.g., "Medical", "Relief", etc.
  type        String   @default("IMAGE") // IMAGE or VIDEO
  videoUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  content     String   @db.Text
  image       String?
  role        String?
  date        DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  user      String
  text      String   @db.Text
  time      String
  createdAt DateTime @default(now())
}
