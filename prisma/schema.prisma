// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  profile       Profile?
  enrollments   Enrollment[]
  lessonStats   LessonStats[]
  resetTokens   PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Profile {
  id                String  @id @default(cuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id])
  title             String?
  vid               String? @unique
  firstName         String?
  lastName          String?
  phone             String?
  gender            String?
  dob               String?
  profession        String?
  qualification     String?
  preferredRole     String?
  church            String?
  location          String?
  country           String?
  bloodGroup        String?
  socialMediaHandle String?
  newsletter        Boolean @default(false)
  stats             Int     @default(0)
  status            String  @default("Pending")
  bio               String? @db.Text
  avatar            String?
  dateJoined        DateTime? @default(now())
  timeJoined        String?
  ref               String?
}

enum Role {
  USER
  ADMIN
  VOLUNTEER
  MEMBER
  PARTNER
  INSTRUCTOR
}

model Instructor {
  id              String   @id @default(cuid())
  iid             String   @unique
  firstName       String
  lastName        String
  email           String   @unique
  phone           String?
  bio             String?  @db.Text
  discipline      String?
  qualification   String?
  avatar          String?
  country         String?
  facebook        String?
  twitter         String?
  linkedin        String?
  instagram       String?
  courses         Course[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Course {
  id            String    @id @default(cuid())
  cid           String    @unique
  title         String
  brief         String?   @db.Text
  description   String?   @db.Text
  image         String?
  price         Float     @default(0)
  duration      String?
  level         String?   @default("Beginner") // Beginner, Intermediate, Advanced
  categoryId    String
  category      CourseCategory @relation(fields: [categoryId], references: [id])
  instructorId  String?
  instructor    Instructor?    @relation(fields: [instructorId], references: [id])
  lessons       Lesson[]
  enrollments   Enrollment[]
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CourseCategory {
  id        String   @id @default(cuid())
  cid       String?  @unique
  name      String   @unique
  courses   Course[]
  createdAt DateTime @default(now())
}

model Lesson {
  id          String   @id @default(cuid())
  lid         String   @unique
  title       String
  content     String?  @db.Text
  videoUrl    String?
  duration    String?
  order       Int      @default(0)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  lessonStats LessonStats[]
  createdAt   DateTime @default(now())
}

model LessonStats {
  id        String   @id @default(cuid())
  lessonId  String
  userId    String
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  status    Int      @default(0) // 1 for completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  user        User     @relation(fields: [userId], references: [id])
  course      Course   @relation(fields: [courseId], references: [id])
  progress    Float    @default(0)
  isCompleted Boolean  @default(false)
  enrolledAt  DateTime @default(now())
  completedAt DateTime?

  @@unique([userId, courseId])
}

model HeroSlide {
  id          String   @id @default(cuid())
  title       String
  subTitle    String?
  description String?
  image       String
  link        String?
  btnText     String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model DailyConfession {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  title     String
  text      String
  audioUrl  String?
  link      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MarqueeItem {
  id        String   @id @default(cuid())
  content   String
  link      String?
  color     String?  @default("red")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Campaign {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  image       String
  region      String?
  country     String?
  category    String   // e.g., "Good Deeds Campaigns", "Medical Projects", etc.
  date        DateTime?
  isActive    Boolean  @default(true)
  ctaType     String?  @default("DONATE") // DONATE, REGISTER, LINK, etc.
  ctaText     String?  @default("Give Now")
  ctaLink     String?
  target      Float?   @default(0)
  raised      Float?   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model News {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  image       String?
  category    String?
  author      String?
  date        DateTime @default(now())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Blog {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  image       String?
  category    String?
  author      String?
  date        DateTime @default(now())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  eid         String?  @unique
  title       String
  brief       String?  @db.Text
  description String?  @db.Text
  image       String?
  location    String?
  date        DateTime
  startDate   String?
  endDate     String?
  startTime   String?
  endTime     String?
  isLive      Boolean  @default(false)
  streamUrl   String?
  isActive    Boolean  @default(true)
  volOnly     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Gallery {
  id          String   @id @default(cuid())
  title       String?
  imageUrl    String
  category    String?  // e.g., "Medical", "Relief", etc.
  type        String   @default("IMAGE") // IMAGE or VIDEO
  videoUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  content     String   @db.Text
  image       String?
  role        String?
  date        DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  user      String
  text      String   @db.Text
  time      String
  createdAt DateTime @default(now())
}

